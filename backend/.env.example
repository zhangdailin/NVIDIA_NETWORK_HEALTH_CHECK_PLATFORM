# NVIDIA Network Health Check Platform - Backend Configuration
# Copy this file to .env and customize for your environment

# ============================================
# Server Settings
# ============================================
HOST=0.0.0.0
PORT=8000

# Development mode (set to false in production)
RELOAD=true

# ============================================
# CORS Configuration
# ============================================
# Comma-separated list of allowed origins
CORS_ORIGINS=http://localhost:5173,http://localhost:8000

# ============================================
# File Upload Settings
# ============================================
# Maximum file size in MB
MAX_FILE_SIZE_MB=500

# ============================================
# Cleanup Settings
# ============================================
# Hours to keep uploaded files before auto-cleanup
CLEANUP_INTERVAL_HOURS=24

# ============================================
# Logging
# ============================================
# Log level: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO

# ============================================
# Analysis Settings
# ============================================
# Number of parallel workers for analysis
MAX_WORKERS=12

# Only return rows with issues (critical/warning) - set to false to return all data
RETURN_ONLY_ISSUES=true

# Maximum rows to return for preview (0 = unlimited)
MAX_PREVIEW_ROWS=2000

# Timeout for individual service execution (seconds)
SERVICE_TIMEOUT_SECONDS=60

# ============================================
# Rate Limiting
# ============================================
# Maximum requests per minute per IP
RATE_LIMIT_REQUESTS_PER_MINUTE=10

# ============================================
# Feature Flags
# ============================================
ENABLE_TOPOLOGY_VISUALIZATION=true
ENABLE_HEALTH_SCORE=true
ENABLE_ANOMALY_DETECTION=true

# ============================================
# Cable Analysis Settings
# ============================================
# Temperature thresholds (Celsius)
CABLE_TEMP_WARNING_THRESHOLD=70
CABLE_TEMP_CRITICAL_THRESHOLD=80

# Maximum cable rows to return
MAX_CABLE_ROWS=2000
