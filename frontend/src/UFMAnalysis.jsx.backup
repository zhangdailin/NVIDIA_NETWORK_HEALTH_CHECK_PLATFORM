          margin: 0 0 16px 0;
          font-size: 1.1rem;
        }

        .traffic-metrics {
          display: flex;
          flex-direction: column;
          gap: 10px;
        }

        .traffic-metric {
          display: flex;
          justify-content: space-between;
          padding: 8px 0;
          border-bottom: 1px solid #1e293b;
        }

        .traffic-metric:last-child {
          border-bottom: none;
        }

        .bandwidth-section, .congestion-section {
          margin-top: 24px;
        }

        .bandwidth-section h3, .congestion-section h3 {
          margin-bottom: 16px;
          font-size: 1.15rem;
        }

        /* Port Distribution Styles */
        .distribution-section {
          margin-bottom: 32px;
        }

        .distribution-section:last-child {
          margin-bottom: 0;
        }

        .distribution-section h3 {
          color: #f1f5f9;
          margin-bottom: 16px;
          font-size: 1.2rem;
        }

        .distribution-list {
          display: flex;
          flex-direction: column;
          gap: 12px;
        }

        .distribution-item {
          background: #0f172a;
          padding: 16px;
          border-radius: 8px;
          display: flex;
          justify-content: space-between;
          align-items: center;
          gap: 16px;
          transition: all 0.2s;
        }

        .distribution-item:hover {
          background: #1e293b;
          transform: translateX(4px);
        }

        .distribution-left {
          flex: 1;
          display: flex;
          flex-direction: column;
          gap: 8px;
        }

        .distribution-name {
          color: #f1f5f9;
          font-weight: 500;
          font-size: 1rem;
        }

        .distribution-bar {
          height: 8px;
          background: #1e293b;
          border-radius: 4px;
          overflow: hidden;
          width: 100%;
        }

        .distribution-bar-fill {
          height: 100%;
          border-radius: 4px;
          transition: width 0.5s ease;
        }

        .distribution-right {
