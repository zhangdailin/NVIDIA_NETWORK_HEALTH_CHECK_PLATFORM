          align-items: center;
          gap: 8px;
          flex-shrink: 0;
        }

        .distribution-count {
          color: #f1f5f9;
          font-weight: 700;
          font-size: 1.2rem;
        }

        .distribution-percentage {
          color: #94a3b8;
          font-size: 0.9rem;
        }

        /* Issues Summary Styles */
        .issues-summary {
          background: linear-gradient(135deg, #1e293b 0%, #0f172a 100%);
          border: 2px solid #ef4444;
        }

        .issues-critical, .issues-warning {
          margin-bottom: 32px;
        }

        .issues-critical:last-child, .issues-warning:last-child {
          margin-bottom: 0;
        }

        .issue-cards {
          display: grid;
          grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
          gap: 16px;
        }

        .issue-card {
          background: #0f172a;
          padding: 20px;
          border-radius: 10px;
          display: flex;
          flex-direction: column;
          gap: 12px;
          transition: all 0.2s;
