{
  "name": "nvidia-network-health-check-platform",
  "version": "1.0.0",
  "description": "NVIDIA InfiniBand Network Health Check Platform",
  "private": true,
  "workspaces": [
    "frontend"
  ],
  "scripts": {
    "dev": "concurrently \"npm run backend\" \"npm run frontend\"",
    "server": "concurrently \"npm run backend\" \"npm run frontend\"",
    "backend": "cd backend && python -m uvicorn main:app --reload --port 8000 --timeout-keep-alive 300",
    "frontend": "npm run dev --workspace=frontend",
    "build": "node build.js",
    "build:prod": "node build.js",
    "start": "cd backend && python -m uvicorn main:app --host 0.0.0.0 --port 8000 --timeout-keep-alive 300",
    "start:prod": "npm run build && npm start",
    "install:all": "npm install && cd backend && pip install -r requirements.txt",
    "install:backend": "cd backend && pip install -r requirements.txt",
    "clean": "rimraf node_modules frontend/node_modules frontend/dist frontend/.vite backend/static",
    "clean:build": "rimraf frontend/dist frontend/.vite backend/static"
  },
  "devDependencies": {
    "concurrently": "^8.2.2",
    "rimraf": "^5.0.5"
  },
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=9.0.0"
  }
}
